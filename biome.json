{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**", "scripts/**", "*.ts", "*.json", "!**/*.golden.*"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    },
    "globals": ["__APP_INFO__"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noLeakedRender": "error",
        "useArraySortCompare": "error",
        "noReturnAssign": "error",
        "noEqualsToNull": "error",
        "useAwait": "error",
        "noNestedPromises": "error",
        "noUnnecessaryConditions": "off"
      },
      "correctness": {
        "noUndeclaredVariables": "error",
        "noUnresolvedImports": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/platform/voiceWorklet.js"],
      "javascript": {
        "globals": ["AudioWorkletProcessor", "registerProcessor", "sampleRate", "currentTime"]
      }
    }
  ]
}
