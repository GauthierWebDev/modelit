{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions de la fenêtre principale. Les fichiers ne sont accessibles qu'après sélection par l'utilisateur dans un dialogue (le plugin dialog étend alors la portée du plugin fs), ou, pour un modèle .mcd désigné par son chemin (récents, glisser-déposer, ligne de commande), après la commande allow_model_file, qui n'accepte que ces fichiers. Liens externes : dépôt GitHub et texte de la licence uniquement. Fenêtres flottantes (O-45, O-46) : création, géométrie, affichage et fermeture des fenêtres float-*. Commandes de l'application (MCP, session collaborative, mises à jour) : fenêtre principale seulement.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-exists",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/GauthierWebDev/modelit*"
        },
        {
          "url": "https://www.gnu.org/licenses/*"
        }
      ]
    },
    "deep-link:default",
    "allow-mcp-start",
    "allow-mcp-stop",
    "allow-mcp-reply",
    "allow-mcp-release-others",
    "allow-collab-host-start",
    "allow-collab-host-send",
    "allow-collab-host-datagram",
    "allow-collab-host-close",
    "allow-collab-host-stop",
    "allow-collab-guest-connect",
    "allow-collab-guest-send",
    "allow-collab-guest-datagram",
    "allow-collab-guest-close",
    "allow-updater-configured",
    "allow-allow-model-file",
    "allow-launch-files",
    "allow-cli-status",
    "allow-cli-install",
    "allow-cli-uninstall"
  ]
}
